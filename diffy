#!/usr/bin/env python3
"""diffy: a local, read-only git diff reviewer that posts line comments to a webhook.

Usage:
  diffy serve [--host 127.0.0.1] [--port 4747] [--passcode CODE]
  diffy rediscover      re-scan repo roots and print the repos found
  diffy ping            POST {"action":"ping"} to the webhook once

Passcode: on localhost (the default) there is none. With a non-loopback --host
(e.g. 0.0.0.0 for Tailscale) every page and API call needs a passcode: "passcode"
from config.json, else --passcode, else a fresh random one each run. Startup prints
links with ?k=CODE; opening one once sets a session cookie in that browser.
"""
import argparse, hmac, json, os, secrets, threading, socket, subprocess, sys, time, urllib.request, urllib.error
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs, urlencode

HERE = os.path.dirname(os.path.realpath(__file__))
CONF_DIR = os.environ.get("DIFFY_CONFIG_DIR", os.path.join(os.path.expanduser("~"), ".config", "diffy"))
CONF = os.path.join(CONF_DIR, "config.json")
REPOS = os.path.join(CONF_DIR, "repos.json")
PENDING = os.path.join(CONF_DIR, "pending.jsonl")
SKIP = {"node_modules", ".cache", ".local", ".npm", ".cargo", ".rustup", "go", "vendor", ".venv", "venv", "Library"}

def config():
    with open(CONF) as f: return json.load(f)

def short_host():
    return socket.gethostname().split(".")[0] or os.uname().nodename

def machine():
    try: return config().get("machine") or short_host()
    except Exception: return short_host()

def discover():
    c = config(); found = {}
    def add(path):
        path = os.path.realpath(path); name = os.path.basename(path)
        if path in found.values(): return
        if name in found: name = os.path.basename(os.path.dirname(path)) + "/" + name
        found[name] = path
    for p in c.get("repos") or []:
        p = os.path.expanduser(p)
        if os.path.isdir(os.path.join(p, ".git")): add(p)
    if c.get("roots"):
        depth = int(c.get("depth", 4))
        for root in [os.path.expanduser(r) for r in c["roots"]]:
            if not os.path.isdir(root): continue
            base = root.rstrip(os.sep).count(os.sep)
            for d, dirs, _ in os.walk(root):
                if ".git" in dirs:
                    add(d); dirs[:] = []; continue
                dirs[:] = [x for x in dirs if x not in SKIP and not x.startswith(".")]
                if d.count(os.sep) - base >= depth: dirs[:] = []
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(REPOS, "w") as f: json.dump(found, f, indent=1)
    return found

def has_scope():
    try: c = config()
    except Exception: return False
    return bool(c.get("roots") or c.get("repos"))

NO_SCOPE = """<!doctype html><meta charset="utf-8"><title>diffy: no repo folder</title>
<body style="background:#0d1117;color:#d1d7e0;font:15px system-ui;padding:40px;max-width:640px">
<h2>diffy has no repo folder configured</h2>
<p>diffy only shows repos inside folders you choose. It never scans your whole home folder.</p>
<p>Run the installer with the folder that holds your repos, then restart <code>diffy serve</code>:</p>
<pre style="background:#161b22;padding:12px;border-radius:6px">./install.sh --roots ~/workspace</pre>
</body>"""

def load_repos():
    if not has_scope(): return {}
    try:
        with open(REPOS) as f: return json.load(f)
    except Exception: return discover()

def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, "--no-optional-locks", *args], capture_output=True, text=True, errors="replace", timeout=30)
    return r.stdout

def repo_info(name, path):
    br = git(path, "rev-parse", "--abbrev-ref", "HEAD").strip()
    st = [l for l in git(path, "status", "--porcelain").splitlines() if l.strip()]
    return {"name": name, "path": path, "branch": br, "dirty": len(st)}

def untracked_diff(path):
    d = ""
    for f in git(path, "ls-files", "--others", "--exclude-standard", "-z").split("\0"):
        if not f: continue
        r = subprocess.run(["git", "-C", path, "--no-optional-locks", "diff", "--no-index", "--no-color", "--src-prefix=a/", "--dst-prefix=b/", "--", "/dev/null", f],
                           capture_output=True, text=True, errors="replace", timeout=30)
        d += r.stdout
    return d

def default_base(path):
    for b in ("origin/main", "origin/master", "main", "master"):
        if git(path, "rev-parse", "--verify", "-q", b).strip(): return b
    return "HEAD"

def safe_ref(r):
    return bool(r) and not r.startswith("-") and all(c.isalnum() or c in "/._-~^" for c in r)

DF = ["--no-color", "--no-ext-diff", "-M", "--src-prefix=a/", "--dst-prefix=b/"]
def scoped_diff(path, scope, base, commit):
    if scope == "commit" and safe_ref(commit):
        meta = git(path, "show", "-s", "--format=%H%x00%s%x00%an%x00%ct%x00%b", commit).split("\0")
        d = git(path, "show", "--format=", *DF, commit)
        return d, {"sha": meta[0].strip(), "subject": meta[1], "author": meta[2], "ts": int(meta[3] or 0), "body": meta[4].strip() if len(meta) > 4 else ""}
    if scope == "staged": return git(path, "diff", "--cached", *DF), None
    if scope == "unstaged": return git(path, "diff", *DF) + untracked_diff(path), None
    if scope == "last": return git(path, "diff", "HEAD~1", "HEAD", *DF), None
    if scope == "all":
        mb = git(path, "merge-base", base, "HEAD").strip() if safe_ref(base) else ""
        if mb: return git(path, "diff", mb, *DF) + untracked_diff(path), None
    return git(path, "diff", "HEAD", *DF) + untracked_diff(path), None

def branches(path):
    refs = git(path, "for-each-ref", "--format=%(refname:short)", "refs/remotes", "refs/heads").split()
    return {"refs": [r for r in refs if not r.endswith("/HEAD")], "default": default_base(path)}

FMT = "--format=%H%x00%s%x00%an%x00%ct"
def commits(path, base):
    def parse(out):
        res = []
        for l in out.splitlines():
            p = l.split("\0")
            if len(p) == 4: res.append({"sha": p[0], "subject": p[1], "author": p[2], "ts": int(p[3])})
        return res
    if not safe_ref(base): base = default_base(path)
    mine = parse(git(path, "log", FMT, "-n", "200", f"{base}..HEAD"))
    base_c = parse(git(path, "log", FMT, "-n", "30", base))
    return {"branch": mine, "base": base_c, "baseName": base}

def status(path):
    out = []
    for l in git(path, "status", "--porcelain").splitlines():
        if len(l) > 3: out.append({"x": l[0], "y": l[1], "file": l[3:]})
    return out

def post_webhook(payload):
    c = config()
    req = urllib.request.Request(c["url"], data=json.dumps(payload).encode(), method="POST", headers={
        "Content-Type": "application/json", "Authorization": "Bearer " + c["key"], "X-Automation-Key": c["key"]})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return r.status, None
    except urllib.error.HTTPError as e:
        err = f"HTTP {e.code}"
    except Exception as e:
        err = type(e).__name__ + ": " + str(e)
    with open(PENDING, "a") as f:
        f.write(json.dumps({"ts": int(time.time()), "error": err, "payload": payload}) + "\n")
    return None, err

PASSCODE = None              # set in main() when bound to a non-loopback host
SESSION = secrets.token_urlsafe(32)   # cookie value; new each run
FAILS = {}; FAILS_LOCK = threading.Lock(); MAX_FAILS = 10; LOCKOUT = 600
LOGIN = """<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>diffy</title><style>body{margin:0;height:100vh;display:flex;align-items:center;justify-content:center;background:#0d1117;
color:#c9d1d9;font:14px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}form{background:#161b22;border:1px solid #30363d;
border-radius:8px;padding:24px;width:280px}h1{font-size:16px;margin:0 0 12px}input{box-sizing:border-box;width:100%;padding:8px;
background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;font:inherit}button{margin-top:12px;width:100%;padding:8px;
background:#238636;color:#fff;border:0;border-radius:6px;font:inherit;cursor:pointer}.e{color:#f85149;margin:8px 0 0}</style></head>
<body><form method="post" action="/login"><h1>diffy</h1><input name="k" type="password" placeholder="Passcode" autofocus autocomplete="current-password">
<button>Open</button>{{ERR}}</form></body></html>"""

def locked(ip):
    with FAILS_LOCK:
        n, t = FAILS.get(ip, (0, 0))
        if n >= MAX_FAILS and time.time() - t < LOCKOUT: return True
        if n >= MAX_FAILS: FAILS.pop(ip, None)
    return False

def check_code(ip, code):
    """True if code is right. Wrong codes are counted per IP and slowed down."""
    if locked(ip): return False
    if code and hmac.compare_digest(code.encode(), PASSCODE.encode()):
        with FAILS_LOCK: FAILS.pop(ip, None)
        return True
    with FAILS_LOCK:
        n, _ = FAILS.get(ip, (0, 0)); FAILS[ip] = (n + 1, time.time())
    time.sleep(1)
    return False


class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code); self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    def has_session(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "diffy_session" and hmac.compare_digest(v.encode(), SESSION.encode()): return True
        return False
    def grant(self, location):
        self.send_response(303)
        self.send_header("Set-Cookie", f"diffy_session={SESSION}; HttpOnly; SameSite=Strict; Path=/")
        self.send_header("Location", location); self.send_header("Content-Length", "0"); self.end_headers()
    def login_page(self, code=200, err=""):
        self.send(code, LOGIN.replace("{{ERR}}", f"<p class=\"e\">{err}</p>" if err else ""), "text/html; charset=utf-8")
    def gate(self, u, q):
        """Returns True if the request may proceed; otherwise has already responded."""
        if PASSCODE is None or self.has_session(): return True
        ip = self.client_address[0]
        if "k" in q:
            if check_code(ip, q["k"]):
                rest = {k: v for k, v in q.items() if k != "k"}
                self.grant(u.path + ("?" + urlencode(rest) if rest else "")); return False
            self.login_page(429 if locked(ip) else 401, "Too many attempts. Try later." if locked(ip) else "Wrong passcode."); return False
        if u.path.startswith("/api/"): self.send(401, '{"error":"passcode required"}')
        else: self.login_page(401)
        return False
    def do_GET(self):
        u = urlparse(self.path); q = {k: v[0] for k, v in parse_qs(u.query).items()}
        if not self.gate(u, q): return
        repos = load_repos()
        if u.path == "/" and not has_scope(): return self.send(200, NO_SCOPE, "text/html; charset=utf-8")
        if u.path == "/": return self.send(200, open(os.path.join(HERE, "static", "index.html"), "rb").read(), "text/html; charset=utf-8")
        if u.path in ("/vendor/highlight.min.js", "/vendor/github-dark.min.css"):
            with open(os.path.join(HERE, "vendor", "highlight.js", u.path.split("/")[-1]), "rb") as f:
                return self.send(200, f.read(), "application/javascript" if u.path.endswith(".js") else "text/css")
        if u.path == "/api/repos":
            return self.send(200, json.dumps({"machine": machine(), "repos": [repo_info(n, p) for n, p in repos.items()]}))
        n = q.get("repo", "")
        if n not in repos: return self.send(404, '{"error":"unknown repo"}')
        p = repos[n]
        if u.path == "/api/branches": return self.send(200, json.dumps(branches(p)))
        if u.path == "/api/commits": return self.send(200, json.dumps(commits(p, q.get("base", ""))))
        if u.path == "/api/status": return self.send(200, json.dumps(status(p)))
        if u.path == "/api/diff":
            d, meta = scoped_diff(p, q.get("scope", "uncommitted"), q.get("base", ""), q.get("commit", ""))
            info = repo_info(n, p); info["diff"] = d; info["commit"] = meta
            return self.send(200, json.dumps(info))
        self.send(404, '{"error":"not found"}')
    def do_POST(self):
        if PASSCODE is not None and urlparse(self.path).path == "/login":
            ip = self.client_address[0]
            try: body = self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 4096)).decode()
            except Exception: body = ""
            code = parse_qs(body).get("k", [""])[0]
            if check_code(ip, code): return self.grant("/")
            return self.login_page(429 if locked(ip) else 401, "Too many attempts. Try later." if locked(ip) else "Wrong passcode.")
        if not self.gate(urlparse(self.path), {}): return
        if urlparse(self.path).path != "/api/submit": return self.send(404, '{"error":"not found"}')
        try:
            data = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        except Exception: return self.send(400, '{"error":"bad json"}')
        repos = load_repos(); n = data.get("repo")
        if n not in repos: return self.send(400, '{"error":"unknown repo"}')
        comments = [{k: c.get(k) for k in ("file", "line", "side", "code", "text")} for c in data.get("comments", [])]
        payload = {"action": "submit", "machine": machine(), "repo": n, "branch": repo_info(n, repos[n])["branch"],
                   "summary": str(data.get("summary", "")), "comments": comments}
        for k in ("base", "scope", "commit"):
            if data.get(k): payload[k] = str(data[k])
        status, err = post_webhook(payload)
        self.send(200 if status else 502, json.dumps({"ok": bool(status), "status": status, "error": err}))


def other_ips():
    out = []
    try:
        r = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=2)
        ts = r.stdout.split()[0] if r.returncode == 0 and r.stdout.split() else ""
        if ts: out.append(("tailscale", ts))
    except Exception: ts = ""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9)); lan = s.getsockname()[0]; s.close()
        if lan and lan != ts and not lan.startswith("127."): out.append(("lan", lan))
    except Exception: pass
    return out

def main():
    ap = argparse.ArgumentParser(prog="diffy", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", default="serve", choices=["serve", "ping", "rediscover"])
    ap.add_argument("--host", default=None, help="bind address (default 127.0.0.1, or config host); 0.0.0.0 to allow other devices")
    ap.add_argument("--port", type=int, default=None, help="port (default 4747, or config port)")
    ap.add_argument("--passcode", default=None, help="passcode for non-localhost binds (default: config passcode, else random per run); note it lands in shell history")
    a = ap.parse_args()
    if a.cmd in ("rediscover", "serve") and not has_scope():
        print("diffy: no repo folder configured. Run: ./install.sh --roots ~/your/repos", file=sys.stderr)
        if a.cmd == "rediscover": sys.exit(2)
    if a.cmd == "rediscover":
        for n, p in discover().items(): print(f"{n}\t{p}")
        return
    if a.cmd == "ping":
        s, e = post_webhook({"action": "ping", "machine": machine()}); print("ping:", s or e); sys.exit(0 if s == 200 else 1)
    try: c = config()
    except Exception: c = {}
    host = a.host or c.get("host") or "127.0.0.1"; port = a.port or int(c.get("port", 4747))
    if has_scope(): discover()
    global PASSCODE
    if host not in ("127.0.0.1", "localhost", "::1"):
        if a.passcode: print("diffy: note --passcode is saved in your shell history; prefer \"passcode\" in config.json", file=sys.stderr)
        PASSCODE = a.passcode or c.get("passcode") or secrets.token_urlsafe(8)
        k = "?" + urlencode({"k": PASSCODE})
        print(f"diffy on http://localhost:{port}/{k}", flush=True)
        for label, ip in other_ips():
            print(f"  {label}: http://{ip}:{port}/{k}", flush=True)
        print(f"  passcode: {PASSCODE}  (open a link once per browser; a cookie keeps you in until diffy restarts)", flush=True)
    else:
        print(f"diffy on http://localhost:{port}/", flush=True)
    print("Ctrl+C to stop", flush=True)
    try: ThreadingHTTPServer((host, port), H).serve_forever()
    except KeyboardInterrupt: pass

if __name__ == "__main__":
    main()
